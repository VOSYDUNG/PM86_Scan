{
  "expo": {
    "name": "PM86 StockCount",
    "slug": "pm86-stockcount",
    "scheme": "pm86stockcount",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 30
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần quyền Camera để quét mã vạch kiểm kê."
        }
      ]
    ],
    "icon": "./assets/LOGO_1_square.png",
    "splash": {
      "image": "./assets/LOGO_2.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.nnc.pm86stockcount",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
      "foregroundImage": "./assets/LOGO_1_square.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "image": "./assets/LOGO_2.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "assetBundlePatterns": ["**/*"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
